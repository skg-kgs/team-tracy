body: |2-
  'server/main.rs:init_tracing' (its doc comment is the map)
  'server/types/misc.rs:logs_dir'
  'server/view_snapshots.rs' (its module comment)
  'server/serve.rs:handle_emacs' (the one "Received request" line per request)
  'elisp/skg-log.el:skg-log'
  'elisp/skg-client.el:skg--run-folder-for-messages'
